# Load the base protein force field
source leaprc.gaff2
source leaprc.protein.ff19SB

# Load heme residue definition and parameters
loadAmberPrep mo.prepin
loadAmberParams mo.frcmod

# Create a unit containing just the HEM residue from the prep template
mow = sequence { MOW }

saveAmberParm mow mow.prmtop mow.inpcrd
quit
